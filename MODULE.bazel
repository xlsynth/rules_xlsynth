module(name = "rules_xlsynth")

bazel_dep(name = "bazel_skylib", version = "1.6.1")
bazel_dep(name = "rules_cc", version = "0.2.11")
bazel_dep(name = "rules_python", version = "1.0.0")

xls = use_extension("//:extensions.bzl", "xls", dev_dependency = True)
xls.toolchain(
    name = "rules_xlsynth_selftest_xls",
    artifact_source = "download_only",
    emit_resolved_identity = True,
    xls_version = "0.54.7",
    xlsynth_driver_version = "0.66.0",
)
xls.toolchain(
    name = "rules_xlsynth_bx_xls",
    artifact_source = "download_only",
    xls_version = "0.62.0",
    xlsynth_driver_version = "0.83.0",
)

# Mirror the explicit override repo name used by the standalone smoke example
# so `bazel test //...` from the repo root can still analyze that package.
xls.toolchain(
    name = "workspace_override_xls",
    artifact_source = "download_only",
    xls_version = "0.54.7",
    xlsynth_driver_version = "0.66.0",
)

# Selected explicitly by the Lean proof examples.
xls.toolchain(
    name = "rules_xlsynth_lean_test_xls",
    artifact_source = "download_only",
    lean_artifact_source = "download_only",
    lean_version = "4.34.1",
    xls_version = "0.62.0",
    xlsynth_driver_version = "0.83.0",
)
use_repo(
    xls,
    "rules_xlsynth_bx_xls_runtime",
    "rules_xlsynth_bx_xls_toolchain",
    "rules_xlsynth_lean_test_xls_toolchain",
    "rules_xlsynth_selftest_xls_runtime",
    "rules_xlsynth_selftest_xls_toolchain",
    "workspace_override_xls_runtime",
    "workspace_override_xls_toolchain",
)

register_toolchains(
    "@rules_xlsynth_selftest_xls_toolchain//:all",
    dev_dependency = True,
)
