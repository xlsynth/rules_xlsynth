load("//:rules.bzl", "dslx_lean_equiv_test", "dslx_library", "dslx_to_ir", "ir_fn_lean_equiv_test")

dslx_library(
    name = "identity_lib",
    srcs = ["identity.x"],
)

dslx_library(
    name = "reference_lib",
    testonly = True,
    srcs = ["reference.x"],
)

dslx_lean_equiv_test(
    name = "dslx_identity_test",
    allow_native_checks = False,
    lhs = ":identity_lib",
    lhs_top = "identity",
    proof = "Reflexivity.lean",
    proof_theorem = "Reflexivity.equivalent",
    rhs = ":reference_lib",
    rhs_top = "add_zero",
    tags = ["manual"],
    xls_bundle = "@rules_xlsynth_lean_test_xls_toolchain//:bundle",
)

dslx_to_ir(
    name = "identity_ir",
    lib = ":identity_lib",
    top = "identity",
)

ir_fn_lean_equiv_test(
    name = "identity_test",
    lhs = ":identity_ir",
    proof = "Identity.lean",
    proof_theorem = "Identity.equivalent",
    rhs = "reference.ir",
    rhs_top = "add_zero",
    tags = ["manual"],
    xls_bundle = "@rules_xlsynth_lean_test_xls_toolchain//:bundle",
)
