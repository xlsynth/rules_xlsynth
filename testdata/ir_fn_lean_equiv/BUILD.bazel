load("//:rules.bzl", "dslx_lean_equiv_test", "dslx_library", "dslx_to_ir", "ir_fn_lean_equiv_test")

dslx_library(
    name = "identity_lib",
    srcs = ["identity.x"],
)

dslx_library(
    name = "reference_lib",
    testonly = True,
    srcs = ["reference.x"],
)

dslx_lean_equiv_test(
    name = "dslx_identity_test",
    allow_native_checks = False,
    lhs = ":identity_lib",
    lhs_ir_sha256 = "f5d3d6336341854706bddcad7b05089d50937c237e107db202186d37f705d1e6",
    lhs_top = "identity",
    proof = "Reflexivity.lean",
    proof_theorem = "Reflexivity.equivalent",
    rhs = ":reference_lib",
    rhs_ir_sha256 = "aff50280a1d7f25b2a27c66525e82418d12b6ed02f6a35bf8d0896894b6dbcd1",
    rhs_top = "add_zero",
    tags = ["manual"],
    xls_bundle = "@rules_xlsynth_lean_test_xls_toolchain//:bundle",
)

# Presubmit requires Lean to reject the same proof for identity versus add-one.
dslx_lean_equiv_test(
    name = "dslx_add_one_expect_failure_test",
    allow_native_checks = False,
    lhs = ":identity_lib",
    lhs_top = "identity",
    proof = "Reflexivity.lean",
    proof_theorem = "Reflexivity.equivalent",
    rhs = ":reference_lib",
    rhs_top = "add_one",
    tags = ["manual"],
    xls_bundle = "@rules_xlsynth_lean_test_xls_toolchain//:bundle",
)

dslx_to_ir(
    name = "identity_ir",
    lib = ":identity_lib",
    top = "identity",
)

ir_fn_lean_equiv_test(
    name = "identity_test",
    lhs = ":identity_ir",
    proof = "Identity.lean",
    proof_theorem = "Identity.equivalent",
    rhs = "reference.ir",
    rhs_ir_sha256 = "504562c4ed9ed4edd9edcb1757a288b29caf0602dc75f338ace396bd8870ed97",
    rhs_top = "add_zero",
    tags = ["manual"],
    xls_bundle = "@rules_xlsynth_lean_test_xls_toolchain//:bundle",
)

ir_fn_lean_equiv_test(
    name = "ir_hash_mismatch_expect_failure_test",
    lhs = ":identity_ir",
    proof = "Identity.lean",
    proof_theorem = "Identity.equivalent",
    rhs = "reference.ir",
    rhs_ir_sha256 = "0" * 64,
    rhs_top = "add_zero",
    tags = ["manual"],
    xls_bundle = "@rules_xlsynth_lean_test_xls_toolchain//:bundle",
)
